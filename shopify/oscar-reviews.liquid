{%- comment -%}
============================================================================
  Oscar Pets — "What Our Customers Say" reviews section (STANDALONE)
  ----------------------------------------------------------------------------
  Drop-in Shopify section. Save this file as:
      sections/oscar-reviews.liquid
  Then add it to any page via the theme editor ("Add section" → "Oscar Reviews"),
  or include it in a template with: {% section 'oscar-reviews' %}

  • No app, no framework, no external JS libraries (vanilla JS only).
  • All CSS + JS is inlined and SCOPED to this section's unique id, so it
    cannot collide with or overwrite anything else in your theme.
  • Renders immediately on add (ships with default review blocks).
  • Add / edit / remove reviews from the theme editor — no code needed.
============================================================================
{%- endcomment -%}

{%- liquid
  assign green = section.settings.star_color | default: '#00B67A'
  assign navy  = section.settings.title_color | default: '#0D1B2A'
  assign bg    = section.settings.bg_color | default: '#F8F9FA'
  assign uid   = section.id
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ uid }} .ocr-wrap {
    --ocr-green: {{ green }};
    --ocr-navy: {{ navy }};
    --ocr-bg: {{ bg }};
    background: var(--ocr-bg);
    font-family: 'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  #shopify-section-{{ uid }} .ocr-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px clamp(16px, 4vw, 48px);
  }
  #shopify-section-{{ uid }} .ocr-head { text-align: center; margin-bottom: 48px; }
  #shopify-section-{{ uid }} .ocr-h2 {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-weight: 700;
    color: var(--ocr-navy);
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.15;
    margin: 0;
  }
  #shopify-section-{{ uid }} .ocr-rating {
    display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap;
    justify-content: center; margin-top: 16px;
  }
  #shopify-section-{{ uid }} .ocr-rating .ocr-rated {
    font-weight: 600; color: var(--ocr-navy); font-size: 15px;
  }
  #shopify-section-{{ uid }} .ocr-rating .ocr-count { color: #6b7280; font-size: 14px; }

  #shopify-section-{{ uid }} .ocr-stars { display: inline-flex; gap: 2px; }
  #shopify-section-{{ uid }} .ocr-stars svg { display: block; }

  #shopify-section-{{ uid }} .ocr-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-height: 700px;
    overflow: hidden;
  }
  #shopify-section-{{ uid }} .ocr-col { overflow: hidden; }
  #shopify-section-{{ uid }} .ocr-track {
    display: flex; flex-direction: column; gap: 16px;
    will-change: transform;
  }

  #shopify-section-{{ uid }} .ocr-card {
    background: #fff;
    border: 1px solid #f3f4f6;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(13,27,42,0.06);
    padding: 24px;
  }
  #shopify-section-{{ uid }} .ocr-meta { font-size: 12px; color: #6b7280; margin: 12px 0 0; }
  #shopify-section-{{ uid }} .ocr-title {
    font-weight: 600; color: var(--ocr-navy); font-size: 15px; line-height: 1.35; margin: 12px 0 0;
  }
  #shopify-section-{{ uid }} .ocr-bodywrap { position: relative; height: 96px; overflow: hidden; margin-top: 12px; }
  #shopify-section-{{ uid }} .ocr-body { font-size: 13.5px; line-height: 1.55; color: #374151; margin: 0; }
  #shopify-section-{{ uid }} .ocr-fade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 56px; pointer-events: none;
    background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, #fff 80%);
  }
  #shopify-section-{{ uid }} .ocr-readmore {
    margin-top: 12px; font-family: inherit; font-size: 14px; font-weight: 500;
    color: var(--ocr-navy); background: transparent; border: 0; padding: 0; cursor: pointer;
  }
  #shopify-section-{{ uid }} .ocr-readmore:hover { text-decoration: underline; }
  #shopify-section-{{ uid }} .ocr-readmore:focus-visible { outline: 2px solid var(--ocr-navy); outline-offset: 3px; border-radius: 2px; }

  /* Modal */
  #shopify-section-{{ uid }} .ocr-modal {
    position: fixed; inset: 0; z-index: 9999; display: none;
    align-items: center; justify-content: center;
    background: rgba(0,0,0,0.6);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  #shopify-section-{{ uid }} .ocr-modal.is-open { display: flex; }
  #shopify-section-{{ uid }} .ocr-modal-card {
    position: relative; background: #fff; border-radius: 16px;
    max-width: 32rem; width: 90%; padding: 32px;
    max-height: 85vh; overflow-y: auto;
  }
  #shopify-section-{{ uid }} .ocr-close {
    position: absolute; top: 14px; right: 18px; background: transparent; border: 0;
    font-size: 22px; line-height: 1; cursor: pointer; color: var(--ocr-navy);
  }
  #shopify-section-{{ uid }} .ocr-modal .ocr-title { font-size: 18px; }
  #shopify-section-{{ uid }} .ocr-modal .ocr-body { font-size: 14.5px; line-height: 1.6; margin-top: 16px; }

  @media (max-width: 900px) {
    #shopify-section-{{ uid }} .ocr-cols { grid-template-columns: 1fr; max-height: 760px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ uid }} .ocr-track { transform: none !important; }
  }
</style>

<div class="ocr-wrap" data-ocr-section="{{ uid }}">
  <div class="ocr-inner">

    <div class="ocr-head">
      <h2 class="ocr-h2">{{ section.settings.heading | escape }}</h2>
      <div class="ocr-rating">
        <span class="ocr-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg width="20" height="20" viewBox="0 0 24 24"><rect width="24" height="24" rx="2" fill="{{ green }}"/><path d="M12 5.5l1.94 4.18 4.56.42-3.43 3.07 1.02 4.48L12 15.27l-4.09 2.38 1.02-4.48L5.5 10.1l4.56-.42L12 5.5z" fill="#fff"/></svg>
          {%- endfor -%}
        </span>
        <span class="ocr-rated">{{ section.settings.rating_text | escape }}</span>
        <span class="ocr-count">· {{ section.settings.count_text | escape }}</span>
      </div>
    </div>

    <div class="ocr-cols">
      {%- for col in (0..2) -%}
        <div class="ocr-col" data-speed="{% case col %}{% when 0 %}25{% when 1 %}18{% else %}13{% endcase %}">
          <div class="ocr-track">
            {%- for block in section.blocks -%}
              {%- assign m = forloop.index0 | modulo: 3 -%}
              {%- if m == col -%}
                {%- assign stars = block.settings.stars | default: 5 -%}
                <article class="ocr-card"
                  {{ block.shopify_attributes }}
                  data-name="{{ block.settings.name | escape }}"
                  data-date="{{ block.settings.date | escape }}"
                  data-title="{{ block.settings.title | escape }}"
                  data-stars="{{ stars }}"
                  data-body="{{ block.settings.body | escape }}">
                  <span class="ocr-stars" aria-hidden="true">
                    {%- for i in (1..stars) -%}
                      <svg width="16" height="16" viewBox="0 0 24 24"><rect width="24" height="24" rx="2" fill="{{ green }}"/><path d="M12 5.5l1.94 4.18 4.56.42-3.43 3.07 1.02 4.48L12 15.27l-4.09 2.38 1.02-4.48L5.5 10.1l4.56-.42L12 5.5z" fill="#fff"/></svg>
                    {%- endfor -%}
                  </span>
                  <p class="ocr-meta">{{ block.settings.name | escape }} · {{ block.settings.date | escape }}</p>
                  <h3 class="ocr-title">{{ block.settings.title | escape }}</h3>
                  <div class="ocr-bodywrap">
                    <p class="ocr-body">{{ block.settings.body | escape }}</p>
                    <div class="ocr-fade"></div>
                  </div>
                  <button type="button" class="ocr-readmore">Read more →</button>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Modal (one per section instance) -->
  <div class="ocr-modal" role="dialog" aria-modal="true" aria-label="Customer review">
    <div class="ocr-modal-card">
      <button type="button" class="ocr-close" aria-label="Close">✕</button>
      <span class="ocr-stars ocr-modal-stars" aria-hidden="true"></span>
      <p class="ocr-meta ocr-modal-meta"></p>
      <h3 class="ocr-title ocr-modal-title"></h3>
      <p class="ocr-body ocr-modal-body"></p>
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ uid }}');
  if (!root || root.dataset.ocrInit === '1') return;
  root.dataset.ocrInit = '1';

  var GREEN = {{ green | json }};
  var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function starSvg() {
    return '<svg width="18" height="18" viewBox="0 0 24 24"><rect width="24" height="24" rx="2" fill="' + GREEN + '"/><path d="M12 5.5l1.94 4.18 4.56.42-3.43 3.07 1.02 4.48L12 15.27l-4.09 2.38 1.02-4.48L5.5 10.1l4.56-.42L12 5.5z" fill="#fff"/></svg>';
  }

  /* ---- Seamless auto-scroll per column ---- */
  var cols = root.querySelectorAll('.ocr-col');
  cols.forEach(function (col) {
    var track = col.querySelector('.ocr-track');
    if (!track || !track.children.length) return;

    // Duplicate the cards once for a seamless loop
    track.innerHTML += track.innerHTML;

    if (prefersReduced) return;

    var speed = parseFloat(col.getAttribute('data-speed')) || 20; // seconds per loop
    var paused = false;
    var offset = 0;
    var last = null;

    col.addEventListener('mouseenter', function () { paused = true; });
    col.addEventListener('mouseleave', function () { paused = false; });

    function step(ts) {
      if (last == null) last = ts;
      var dt = (ts - last) / 1000;
      last = ts;
      if (!paused) {
        var half = track.scrollHeight / 2;
        if (half > 0) {
          var pxPerSec = half / speed;
          offset += pxPerSec * dt;
          if (offset >= half) offset -= half;
          track.style.transform = 'translateY(' + (-offset) + 'px)';
        }
      }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  });

  /* ---- Read-more modal ---- */
  var modal = root.querySelector('.ocr-modal');
  var mStars = modal.querySelector('.ocr-modal-stars');
  var mMeta = modal.querySelector('.ocr-modal-meta');
  var mTitle = modal.querySelector('.ocr-modal-title');
  var mBody = modal.querySelector('.ocr-modal-body');

  function openModal(card) {
    var n = parseInt(card.getAttribute('data-stars'), 10) || 5;
    var s = '';
    for (var i = 0; i < n; i++) s += starSvg();
    mStars.innerHTML = s;
    mMeta.textContent = card.getAttribute('data-name') + ' · ' + card.getAttribute('data-date');
    mTitle.textContent = card.getAttribute('data-title');
    mBody.textContent = card.getAttribute('data-body');
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  root.addEventListener('click', function (e) {
    var btn = e.target.closest('.ocr-readmore');
    if (btn) { openModal(btn.closest('.ocr-card')); return; }
    if (e.target === modal || e.target.closest('.ocr-close')) { closeModal(); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });
})();
</script>

{% schema %}
{
  "name": "Oscar Reviews",
  "tag": "section",
  "class": "oscar-reviews-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Rated 4.8 / 5" },
    { "type": "text", "id": "count_text", "label": "Count text", "default": "Based on 200+ reviews" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#00B67A" },
    { "type": "color", "id": "title_color", "label": "Heading / title color", "default": "#0D1B2A" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#F8F9FA" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Reviewer name", "default": "Sarah K." },
        { "type": "text", "id": "date", "label": "Date posted", "default": "2 days ago" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title", "default": "Great product" },
        { "type": "textarea", "id": "body", "label": "Review body", "default": "Wrote a longer review here." }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Oscar Reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Sarah K.",    "date": "2 days ago",  "stars": 5, "title": "My senior dog acts like a puppy again", "body": "honestly didnt expect much but wow. our 11 year old golden has been on this for about 6 weeks and the difference is wild — shes jumping on the couch again, doing zoomies in the yard, eating better. her stool used to be inconsistent and thats also sorted itself out. would buy again 100%." } },
        { "type": "review", "settings": { "name": "Marcus T.",   "date": "5 days ago",  "stars": 5, "title": "Coat is noticeably softer", "body": "Three weeks in and the coat change is real. My border collie's fur used to be a bit coarse and now it's soft to the touch. Shedding also down. No issues with the chews — he eats them like treats." } },
        { "type": "review", "settings": { "name": "Aisha B.",    "date": "1 week ago",  "stars": 5, "title": "Digestion sorted within a week", "body": "we tried 3 other probiotics before this one and nothing worked for our frenchie's tummy issues. by day 5 of oscar her stools were normal for the first time in months. she loves the taste too." } },
        { "type": "review", "settings": { "name": "Daniel P.",   "date": "1 week ago",  "stars": 5, "title": "Worth it", "body": "good stuff. dog likes em. coat shiny." } },
        { "type": "review", "settings": { "name": "Priya R.",    "date": "2 weeks ago", "stars": 5, "title": "Game changer for joint stiffness", "body": "My 9-year-old lab was struggling to get up after naps. A friend recommended oscar and within 3 weeks the stiffness was visibly less. He's chasing the ball again and walking up the stairs without complaining." } },
        { "type": "review", "settings": { "name": "Liam W.",     "date": "2 weeks ago", "stars": 5, "title": "Energy levels up", "body": "Noticed a clear difference in energy after about 10 days. my dog used to be sluggish in the afternoons and now she's basically a different animal. happy with the purchase." } },
        { "type": "review", "settings": { "name": "Mei L.",      "date": "3 days ago",  "stars": 5, "title": "Picky eater approved", "body": "this is the only supplement my shih tzu doesn't spit out. she actively asks for it now lol. coat improvement also visible after about a month, would say its glossier and shedding is way down. great product." } },
        { "type": "review", "settings": { "name": "Jordan F.",   "date": "6 days ago",  "stars": 5, "title": "Solid results", "body": "Bought this on a recommendation. honestly skeptical at first because the marketing felt a bit hyped but after 4 weeks i can confirm — better digestion, better breath, more playful. happy customer." } },
        { "type": "review", "settings": { "name": "Hana O.",     "date": "1 week ago",  "stars": 5, "title": "Helped with allergies", "body": "Our beagle has chronic itchy skin and after about 5 weeks on oscar the scratching has dropped significantly. vet thinks the gut support is helping the immune side of things. happy either way." } },
        { "type": "review", "settings": { "name": "Sam V.",      "date": "10 days ago", "stars": 5, "title": "Great for sensitive stomach", "body": "switched to oscar after our vet suggested adding a probiotic. takes about 2 weeks to kick in but the consistency of her stool is way better and she's not having flare-ups anymore." } },
        { "type": "review", "settings": { "name": "Beatrice C.", "date": "4 days ago",  "stars": 5, "title": "Highly recommend for older dogs", "body": "our 13 year old has been a different dog since starting oscar. more energy, better mood, joint pain seems easier. the vet was impressed at her last check. cant recommend enough — wish we'd started years ago tbh." } },
        { "type": "review", "settings": { "name": "Noor A.",     "date": "3 weeks ago", "stars": 5, "title": "My vet noticed too", "body": "took her in for a routine check after about 6 weeks on oscar and the vet commented on how good her coat looked. i hadnt mentioned the supplement. that was enough validation for me." } }
      ]
    }
  ]
}
{% endschema %}
